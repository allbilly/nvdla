diff --git a/platforms/CMakeLists.txt b/platforms/CMakeLists.txt
index f1b3f4e1..55f6fd0e 100644
--- a/platforms/CMakeLists.txt
+++ b/platforms/CMakeLists.txt
@@ -20,0 +21,12 @@ target_link_libraries(platforms-vp
+# QEMU's HVF accelerator needs the Hypervisor.framework entitlement on macOS.
+if(APPLE)
+    add_custom_command(
+        TARGET platforms-vp
+        POST_BUILD
+        COMMAND codesign
+            --entitlements ${libqemu_SOURCE_DIR}/accel/hvf/entitlements.plist
+            --force -s - $<TARGET_FILE:platforms-vp>
+        COMMENT "Applying HVF entitlements to $<TARGET_FILE:platforms-vp>"
+    )
+endif()
+
