+    MESSAGE(STATUS "TLM2C include directory = ${TLM2C_INCLUDE_DIRS}")
+    MESSAGE(STATUS "TLM2C library directory = ${TLM2C_LIBRARY_DIRS}")
+    SET(TLM2C_LIBRARIES -llibtlm2c.a)
